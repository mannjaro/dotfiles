# 重複を防ぐ
typeset -U path PATH

path=("$HOME/.local/bin" $path)

# 長いコマンドのハイライトを制限
ZSH_HIGHLIGHT_MAXLENGTH=300  

# completion
autoload -Uz compinit
compinit

# syntax highlighting
if command -v brew > /dev/null 2>&1 && [[ -f $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# nvim
if command -v nvim > /dev/null 2>&1; then
  alias vim="nvim"
fi

# eza
if command -v eza > /dev/null 2>&1; then
  alias ls="eza --icons auto --time-style relative -F always --hyperlink -h --git --git-repos --group-directories-first --sort=name --time-style=long-iso -i"
fi

# prompt
if command -v starship > /dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# history
if command -v atuin > /dev/null 2>&1; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# fzf
if command -v fzf > /dev/null 2>&1; then
  source <(fzf --zsh)
fi

# exports
export XDG_CONFIG_HOME=~/.config

# ghq-fzf
ghq-fzf() {
  local repo
  repo=$(ghq list -p | fzf \
    --preview 'ls {}/README* 2>/dev/null | head -n 1 | xargs -I{} sed -n "1,80p" {}' \
    --preview-window right:60%)
  [[ -n "$repo" ]] && cd "$repo"
}

zle -N ghq-fzf
bindkey '^g' ghq-fzf
